{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ],
        "excludes": [
            "Views",
            "commands",
            "Database",
            "Config"
        ]
    },
    "logs": {
        "text": "infection.log",
        "summary": "infection-summary.log"
    },
    "testFramework": "phpunit",
    "bootstrap": "vendor/autoload.php",
    "timeout": 30,
    "phpUnit": {
        "configDir": "."
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 0,
    "minCoveredMsi": 80
}
