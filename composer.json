{
    "name": "enlivenapp/flight-shield",
    "description": "Authentication and authorization for FlightPHP, ported from CodeIgniter Shield",
    "type": "flightphp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "enlivenapp",
            "email": "mw@enlivenapp.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "flightphp/core": "^3.0",
        "enlivenapp/flight-school": "^0.2",
        "enlivenapp/flight-csrf": "^0.1",
        "enlivenapp/flight-settings": "^0.1"
    },
    "suggest": {
        "firebase/php-jwt": "Required for JWT authentication (^6.0)"
    },
    "autoload": {
        "psr-4": {
            "Enlivenapp\\FlightShield\\": "src/"
        },
        "files": [
            "src/Helpers/auth_helper.php"
        ]
    }
}
