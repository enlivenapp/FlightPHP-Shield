{
    "name": "enlivenapp/flight-shield",
    "description": "Authentication and authorization for FlightPHP, ported from CodeIgniter Shield",
    "type": "flightphp-foundation",
    "license": "MIT",
    "authors": [
        {
            "name": "enlivenapp",
            "email": "mw@enlivenapp.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-openssl": "*",
        "flightphp/core": "^3.0",
        "flightphp/active-record": ">=0.7",
        "enlivenapp/flight-csrf": "^1.0",
        "enlivenapp/flight-sessions": "^0.1"
    },
    "suggest": {
        "firebase/php-jwt": "Required for JWT authentication (^7.0)"
    },
    "autoload": {
        "psr-4": {
            "Enlivenapp\\FlightShield\\": "src/"
        },
        "files": [
            "src/Helpers/auth_helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Enlivenapp\\FlightShield\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2",
        "roave/security-advisories": "dev-latest",
        "infection/infection": "^0.35",
        "vimeo/psalm": "6.4.0",
        "firebase/php-jwt": "^7.0"
    },
    "scripts": {
        "phpstan": "phpstan analyse --no-progress",
        "psalm": "psalm --no-progress --taint-analysis",
        "infection": "infection --threads=max",
        "test": "phpunit",
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
